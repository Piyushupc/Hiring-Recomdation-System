# Copy this file to .env (and load it, e.g. with `python-dotenv` or your
# shell) before running the API if you want /send-email to actually work.

# SMTP server used to send interview/rejection emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

# Optional overrides
FROM_EMAIL=your-email@example.com
FROM_NAME=Hiring Team

# Minimum overall score (0-100) for a candidate to be considered a pass.
PASS_THRESHOLD=65
